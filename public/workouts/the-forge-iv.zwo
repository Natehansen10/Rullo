  <workout>
    <Warmup Duration="600" PowerLow="0.45" PowerHigh="0.68"/>
    <SteadyState Duration="3600" Power="0.82"/>
    <Cooldown Duration="300" PowerLow="0.40" PowerHigh="0.55"/>
  </workout>
</workout_file>