    <Warmup Duration="660" PowerLow="0.45" PowerHigh="0.65"/>
    <SteadyState Duration="6120" Power="0.67"/>
    <Cooldown Duration="420" PowerLow="0.40" PowerHigh="0.55"/>
  </workout>
