<workout_file>
  <author>The Workout Generator</author>
  <name>The Caldron</name>
  <description>1 effort block peaking at 100% in 30 minutes. Stay aerodynamic — every unnecessary movement costs energy at this power. This develops the muscular endurance to hold high power under accumulated fatigue. The first interval always feels hardest — trust that you&apos;ll settle in.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="660" PowerLow="0.45" PowerHigh="0.75"/>
    <SteadyState Duration="780" Power="1.00"/>
    <Cooldown Duration="360" PowerLow="0.40" PowerHigh="0.55"/>
  </workout>
</workout_file>