<workout_file>
  <author>The Workout Generator</author>
  <name>Grit Test</name>
  <description>1 effort block peaking at 101% in 45 minutes. Channel the sensation of chasing down a lone rider ahead of you. This improves your lactate buffering so you can tolerate more acid in the legs. The payoff comes in races when you can hold a pace others can&apos;t.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="540" PowerLow="0.45" PowerHigh="0.75"/>
    <SteadyState Duration="1680" Power="1.01"/>
    <Cooldown Duration="480" PowerLow="0.40" PowerHigh="0.55"/>
  </workout>
</workout_file>