<workout_file>
  <author>The Workout Generator</author>
  <name>No Retreat</name>
  <description>1 effort block peaking at 88% in 30 minutes. Use the recovery windows wisely — soft-pedal, drink, reset. This makes race pace feel easier by raising the floor of your sustainable power. Discomfort is the currency — you are buying future performance.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="480" PowerLow="0.45" PowerHigh="0.70"/>
    <SteadyState Duration="1140" Power="0.88"/>
    <Cooldown Duration="180" PowerLow="0.40" PowerHigh="0.55"/>
  </workout>
</workout_file>