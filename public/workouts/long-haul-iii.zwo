<workout_file>
  <author>The Workout Generator</author>
  <name>Long Haul III</name>
  <description>1 effort block peaking at 68% in 90 minutes. Think fluidity — the bike should barely know you&apos;re pedalling. This improves heat dissipation so you perform better in warm conditions. Step off the bike feeling calm and loose, not tired and heavy.</description>
  <sportType>bike</sportType>
  <workout>
    <Warmup Duration="540" PowerLow="0.45" PowerHigh="0.65"/>
    <SteadyState Duration="4440" Power="0.68"/>
    <Cooldown Duration="420" PowerLow="0.40" PowerHigh="0.55"/>
  </workout>
</workout_file>