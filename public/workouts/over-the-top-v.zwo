<workout_file>
  <author>The Workout Generator</author>
  <name>Over the Top V</name>
  <description>2 effort blocks peaking at 100% in 90 minutes. Focus on the process, not the pain — one pedal stroke at a time. This trains your body to clear hydrogen ions faster, delaying the burn. These efforts should feel uncomfortably hard but manageable.</description>
  <sportType>bike</sportType>
