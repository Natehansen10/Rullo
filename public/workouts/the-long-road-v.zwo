  <workout>
    <Warmup Duration="480" PowerLow="0.45" PowerHigh="0.58"/>
    <Warmup Duration="6420" PowerLow="0.60" PowerHigh="0.72"/>
    <Cooldown Duration="300" PowerLow="0.40" PowerHigh="0.55"/>
  </workout>
</workout_file>